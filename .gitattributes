# Keep LF line endings in the repository and the working copy (Makefile, shell, CI on Linux)
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.mp4 binary
*.parquet binary
*.duckdb binary
