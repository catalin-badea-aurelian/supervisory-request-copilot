-- top10_merchant_concentration (preferred source). BigQuery Standard SQL; transpiled to DuckDB by the pack compiler.
WITH base AS (
  SELECT t.merchant_id, DATE(t.txn_ts) AS period_date,
         COALESCE(m.merchant_country, 'XX') AS merchant_country, m.mcc_group,
         t.payment_method, t.status, t.amount_eur
  FROM {{ source('src_transactions') }} AS t
  LEFT JOIN {{ source('src_merchants') }} AS m ON m.merchant_id = t.merchant_id
  WHERE TRUE
    AND t.txn_ts >= TIMESTAMP(@period_start)
    AND t.txn_ts < TIMESTAMP(DATE_ADD(@period_end, INTERVAL 1 DAY))
    AND DATE(t._loaded_at) <= @as_of
    AND t.status IN ('settled', 'refunded')
)
, mv AS (
  SELECT {{ dims_lead }}merchant_id, SUM(amount_eur) AS vol
  FROM base
  WHERE TRUE {{ filters_sql }}
  GROUP BY {{ dim_names_lead }}merchant_id
),
ranked AS (
  SELECT *, ROW_NUMBER() OVER ({% if dims %}PARTITION BY {{ dim_names }} {% endif %}ORDER BY vol DESC, merchant_id) AS rn
  FROM mv
)
SELECT {{ dim_names_lead }}SUM(CASE WHEN rn <= 10 THEN vol ELSE 0 END) AS top10_volume_eur,
  SUM(vol) AS settled_volume_eur,
  SAFE_DIVIDE(
    CAST(SUM(CASE WHEN rn <= 10 THEN vol ELSE 0 END) AS FLOAT64),
    CAST(SUM(vol) AS FLOAT64)) AS top10_merchant_concentration
FROM ranked
{{ group_sql }}
